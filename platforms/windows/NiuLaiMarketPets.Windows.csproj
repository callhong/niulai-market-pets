<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\Resources\BrandMark.ico</ApplicationIcon>
    <RootNamespace>NiuLaiMarketPets.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core\**" />
    <Compile Remove="NiuLaiMarketPets.Windows.Tests\**" />
    <EmbeddedResource Remove="Core\**" />
    <EmbeddedResource Remove="NiuLaiMarketPets.Windows.Tests\**" />
    <Page Remove="Core\**" />
    <Page Remove="NiuLaiMarketPets.Windows.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/NiuLaiMarketPets.Windows.Core.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.10" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\pets\**\*">
      <Link>Assets\Pets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\Resources\Audio\*.wav">
      <Link>Assets\Audio\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\Resources\BrandMark.ico">
      <Link>Assets\BrandMark.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Include="uninstall-windows.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
