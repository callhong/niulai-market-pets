<Window x:Class="NiuLaiMarketPets.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="牛来行情宠物"
        Width="360" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="True">
  <Grid x:Name="RootGrid" Background="Transparent">
    <Ellipse x:Name="MarketGlow" Panel.ZIndex="0" Width="154" Height="110" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,90,0,0" Opacity="0.96" Fill="Transparent" Stroke="Transparent" StrokeThickness="0" IsHitTestVisible="False" />
    <Image x:Name="PetImage" Panel.ZIndex="1" Width="252" Height="273" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" MouseLeftButtonDown="PetImage_OnMouseLeftButtonDown" />
    <Canvas x:Name="SpeechLayer" Panel.ZIndex="5" IsHitTestVisible="False" />
    <Border x:Name="MarketPill" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,42" Padding="10,5" CornerRadius="16" Background="#DDF2F4F6" BorderBrush="#5FFFFFFF" BorderThickness="1" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding TargetDisplayName}" Foreground="#D9000000" FontSize="12" FontWeight="Medium" />
        <TextBlock Text="  " />
        <TextBlock Text="{Binding QuotePrice}" Foreground="#99000000" FontSize="12" FontWeight="Medium" />
        <TextBlock Text="  " />
        <TextBlock Text="{Binding QuotePercent}" Foreground="{Binding MarketBrush}" FontSize="12" FontWeight="SemiBold" />
      </StackPanel>
    </Border>
    <TextBlock Panel.ZIndex="2" Text="{Binding Error}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16" Foreground="#FFE08A27" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
  </Grid>
</Window>
